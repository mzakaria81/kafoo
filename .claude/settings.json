{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(melos:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(dart analyze:*)",
      "Bash(dart format:*)",
      "Bash(dart run build_runner:*)",
      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(supabase status)",
      "Bash(supabase migration new:*)",
      "Bash(supabase db diff:*)",
      "Bash(supabase functions serve:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)",
      "Bash(./scripts/verify.sh)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(supabase db reset)",
      "Bash(supabase functions deploy:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*service-role*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(supabase db push --linked:*)",
      "Bash(supabase link:*)",
      "Bash(wrangler deploy:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-rls.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "SUPABASE_LOCAL_URL": "http://127.0.0.1:54321"
  }
}
