{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "_comment": "Every rule below names a tool this repository actually uses. Derived from pubspec.yaml (Dart pub workspace + melos 8), scripts/verify.sh, .github/workflows/, supabase/config.toml and CLAUDE.md on 2026-08-06. There is no package.json, so there are no npm/pnpm/yarn rules; there is no wrangler and no gh CLI here, so there are none of those either. If you add a tool, add its rules with it — a permission file naming tools the project does not have is a file nobody can trust to be current.",

    "allow": [
      "Bash(melos bootstrap)",
      "Bash(melos list:*)",
      "Bash(melos run analyze)",
      "Bash(melos run test)",
      "Bash(melos run format)",
      "Bash(melos exec:*)",

      "Bash(dart analyze:*)",
      "Bash(dart format:*)",
      "Bash(dart test:*)",
      "Bash(dart run build_runner:*)",
      "Bash(dart pub get)",
      "Bash(dart pub deps:*)",
      "Bash(dart --version)",

      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get)",
      "Bash(flutter gen-l10n:*)",
      "Bash(flutter --version)",
      "Bash(flutter doctor:*)",

      "Bash(deno check:*)",
      "Bash(deno fmt:*)",
      "Bash(deno lint:*)",
      "Bash(deno test:*)",
      "Bash(deno --version)",

      "Bash(supabase status)",
      "Bash(supabase migration list:*)",
      "Bash(supabase --version)",

      "Bash(./scripts/verify.sh)",
      "Bash(./scripts/local-db.sh:*)",
      "Bash(python3 scripts/validate-coordination.py)",
      "Bash(python3 scripts/opencode-spend.py:*)",
      "Bash(python3 scripts/check-l10n-parity.py:*)",
      "Bash(python3 scripts/mutate-policies.py:*)",

      "Bash(opencode models:*)",
      "Bash(opencode stats:*)",
      "Bash(opencode --version)",

      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(git fetch:*)",
      "Bash(git remote -v)",
      "Bash(git describe:*)",
      "Bash(git shortlog:*)",
      "Bash(git stash list)",

      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(tree:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(which:*)",
      "Bash(date:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",

      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(supabase migration new:*)",
      "Bash(supabase functions serve:*)",
      "Bash(supabase db reset)",
      "Bash(supabase functions deploy:*)",
      "Bash(supabase test db:*)",
      "Bash(psql:*)",

      "Bash(deno run:*)",
      "Bash(opencode run:*)",
      "Bash(opencode auth:*)",
      "Bash(flutter build:*)",
      "Bash(flutter create:*)",
      "Bash(dart pub global:*)",
      "Bash(./scripts/install-toolchain.sh:*)",
      "Bash(./scripts/bootstrap.sh:*)",

      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mv:*)",
      "Bash(curl:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*service-role*)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -m:*)",
      "Bash(git tag -d:*)",
      "Bash(git update-ref:*)",
      "Bash(git filter-branch:*)",
      "Bash(git reflog delete:*)",
      "Bash(git commit --amend:*)",

      "Bash(supabase link:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase secrets:*)",

      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -fr:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(sudo:*)",
      "Bash(apt-get:*)",
      "Bash(apt:*)",
      "Bash(pip install:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-rls.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/superpowers-session-start.sh",
            "shell": "bash",
            "async": false
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "shell": "bash",
            "async": false,
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/caveman-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ponytail-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/caveman-mode-tracker.js\"",
            "timeout": 10,
            "statusMessage": "Tracking caveman mode..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ponytail-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking ponytail mode..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ponytail-subagent.js\"",
            "timeout": 5,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ]
  },
  "env": {
    "SUPABASE_LOCAL_URL": "http://127.0.0.1:54321",
    "PONYTAIL_DEFAULT_MODE": "lite",
    "PONYTAIL_SUBAGENT_MATCHER": "general-purpose|^claude$|builder"
  }
}
