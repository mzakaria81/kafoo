{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(melos:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(dart analyze:*)",
      "Bash(dart format:*)",
      "Bash(dart run build_runner:*)",
      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(supabase status)",
      "Bash(supabase migration new:*)",
      "Bash(supabase db diff:*)",
      "Bash(supabase functions serve:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)",
      "Bash(./scripts/verify.sh)",

      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(git fetch:*)",
      "Bash(git remote -v)",
      "Bash(git describe:*)",
      "Bash(git shortlog:*)",
      "Bash(git stash list)",

      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(tree:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(which:*)",
      "Bash(date:*)",

      "Bash(deno check:*)",
      "Bash(deno fmt:*)",
      "Bash(deno lint:*)",
      "Bash(deno test:*)",
      "Bash(./scripts/local-db.sh:*)",
      "Bash(python3 scripts/opencode-spend.py:*)",
      "Bash(python3 scripts/validate-coordination.py)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(supabase db reset)",
      "Bash(supabase functions deploy:*)",

      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(mv:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*service-role*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(supabase db push --linked:*)",
      "Bash(supabase link:*)",
      "Bash(wrangler deploy:*)",
      "Bash(rm -rf:*)",

      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -m:*)",
      "Bash(git tag -d:*)",
      "Bash(git update-ref:*)",
      "Bash(git filter-branch:*)",
      "Bash(git reflog delete:*)",
      "Bash(git commit --amend:*)",
      "Bash(git push --delete:*)",

      "Bash(rm -r:*)",
      "Bash(rm -fr:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(sudo:*)",
      "Bash(apt-get:*)",
      "Bash(apt:*)",
      "Bash(npm install -g:*)",
      "Bash(pnpm add -g:*)",
      "Bash(yarn global:*)",
      "Bash(pip install:*)",

      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(grep .env:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-rls.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/superpowers-session-start.sh",
            "shell": "bash",
            "async": false
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "shell": "bash",
            "async": false,
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/caveman-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ponytail-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/caveman-mode-tracker.js\"",
            "timeout": 10,
            "statusMessage": "Tracking caveman mode..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ponytail-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking ponytail mode..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ponytail-subagent.js\"",
            "timeout": 5,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ]
  },
  "env": {
    "SUPABASE_LOCAL_URL": "http://127.0.0.1:54321",
    "PONYTAIL_DEFAULT_MODE": "lite",
    "PONYTAIL_SUBAGENT_MATCHER": "general-purpose|^claude$|builder"
  }
}
