{
  "name": "Kafoo",

  // Ubuntu base: GNU grep is the default, so `grep -P` in the RLS hook and
  // scripts/verify.sh works without the BSD-grep workaround macOS needs.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    // Node 20+: required by the delegate relays and by `npx` for the
    // Supabase MCP server declared in .mcp.json.
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    // python3: used by .specify/scripts/bash/common.sh and by the
    // ui-ux-pro-max skill's scripts (standard library only, no pip installs).
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    // Docker: `supabase start` runs its stack in containers.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/flutter/bin:${containerEnv:HOME}/.pub-cache/bin:${containerEnv:PATH}"
    // Deliberately NOT set here:
    //   ANTHROPIC_API_KEY  - setting it makes Claude Code bill the API per
    //                        token instead of using the subscription.
    //   SUPABASE_*         - secrets belong in Codespaces secrets, never in
    //                        a committed file. Repo Settings > Secrets and
    //                        variables > Codespaces injects them as env vars,
    //                        which is what .mcp.json reads.
  },

  "forwardPorts": [54321, 54322, 54323, 54324],
  "portsAttributes": {
    "54321": { "label": "Supabase API" },
    "54322": { "label": "Supabase DB" },
    "54323": { "label": "Supabase Studio" },
    "54324": { "label": "Inbucket (mail)" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "anthropic.claude-code",
        "GitHub.vscode-github-actions",
        "esbenp.prettier-vscode"
      ]
    }
  },

  // 4 cores recommended: `supabase start` brings up roughly ten containers
  // and is tight on the 2-core default.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },

  "remoteUser": "vscode"
}
