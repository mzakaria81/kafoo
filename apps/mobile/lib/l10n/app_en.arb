  "@@locale": "en",
  "appTitle": "Kafoo",
  "@appTitle": {
    "description": "The application name, shown in the task switcher."
  },
  "browseKitchenLabel": "from {kitchen}",
  "@browseKitchenLabel": {
    "description": "Names the kitchen behind a Meal on a browse card. 'Who cooked this' is the first question a Customer asks.",
    "placeholders": {
      "kitchen": {
        "type": "String"
      }
    }
  },
  "browseLoading": "Loading food...",
  "@browseLoading": {
    "description": "Announced to a screen reader while the first load runs. Silence is indistinguishable from a broken app."
  },
  "browseNothingOnOffer": "No Meals are on offer right now. There may be something in a little while.",
  "@browseNothingOnOffer": {
    "description": "FR-006. Shown when no Cook anywhere has a Meal on offer. Must be words rather than an empty screen, and must NOT be shown while the first load is running or for a failure. Customer-facing and UNGENDERED per ADR-0010: the first version said 'تعالى بص' — two masculine imperatives — which addressed every woman browsing as a man. First-person plural has no gender in Arabic, which is why the action lives on a button instead of in the sentence. FLAG: wants a native Cairene ear."
  },
  "browseRetry": "Try again",
  "@browseRetry": {
    "description": "Retry button on the browse error state. Pull-to-refresh exposes no semantics action, so it cannot be the only way back. Customer-facing and ungendered per ADR-0010 — a bare imperative that is identical in both forms."
  },
  "browseSignInEntry": "Sign in",
  "@browseSignInEntry": {
    "description": "Entry to signing in, shown to someone with no account. A bare verbal noun: ungendered per ADR-0010, and in the app's own register — 'تسجيل الدخول' was the MSA calque of the English and rendered a 352dp button on a 320dp screen at 200% text scale, clipping the title to nothing."
  },
  "browseTitle": "What's cooking",
  "@browseTitle": {
    "description": "Title of the browse screen: the Meals Cooks currently have on offer. Customer-facing, so no addressForm select (ADR-0010)."
  },
  "discoveryLoadError": "We couldn't load the food right now.",
  "@discoveryLoadError": {
    "description": "Shown to a Customer when the list of Meals on offer cannot be loaded. Customer-facing and ungendered per ADR-0010. States the fact only — the retry is browseRetry on a real button, because the previous copy promised a retry that nothing performed and the screen had no control to press."
  },
  "searchUnavailable": "Search isn't working right now, but browsing what's on offer works as usual.",
  "@searchUnavailable": {
    "description": "Shown to a Customer when search cannot run — the model provider is unreachable, or the request failed. Says search specifically rather than 'something went wrong', because the screen falls back to browsing and the Customer should be able to tell which of the two they are looking at. Customer-facing and ungendered per ADR-0010 — it read 'تقدر تتفرج' until 2026-08-07, which is masculine, in a string that predates the search screen and had been marked ungendered."
  },
  "mealCardSemanticLabel": "{title}, {kitchen}, {price}",
  "@mealCardSemanticLabel": {
    "description": "How a Meal card reads aloud. Composed here rather than in packages/ui so the separator follows the locale — a hardcoded Arabic comma is announced or mispaused by many English voices.",
